          "default": "null",
          "description": "Cari server modeli"
        },
        {
          "name": "parameters",
          "type": "array",
          "default": "[]",
          "description": "Route parametrləri"
        },
        {
          "name": "unmanagedContainers",
          "type": "array",
          "default": "[]",
          "description": "Server-dəki unmanaged Docker container-ları"
