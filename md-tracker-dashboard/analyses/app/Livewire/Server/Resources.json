          ],
          "error_handling": "try/catch → handleError($e, $this)"
        },
        "loadManagedContainers": {
          "logic": "$this->activeTab = 'managed'; $this->server->refresh()",
          "description": "Managed tab-ına keçir və server-i refresh edir"
        },
        "loadUnmanagedContainers": {
          "logic": "$this->activeTab = 'unmanaged'; $this->unmanagedContainers = $this->server->loadUnmanagedContainers()->toArray()",
          "description": "Unmanaged tab-ına keçir və container siyahısını yükləyir",
          "error_handling": "try/catch → handleError($e, $this)"
        },
        "refreshStatus": {
          "logic": "$this->server->refresh(); activeTab-ə görə load çağırır; dispatch('success', 'Resource statuses refreshed.')",
          "description": "Server-i refresh edir və cari tab-ın məlumatlarını yeniləyir"
        },
        "startUnmanaged": {
          "signature": "startUnmanaged($id)",
          "validation": "ValidationPatterns::isValidContainerName($id)",
          "authorization": "authorize('update', $this->server)",
          "logic": "$this->server->startUnmanaged($id); dispatch('success'); loadUnmanagedContainers()",
          "error_handling": "try/catch → handleError($e, $this)"
        },
        "restartUnmanaged": {
          "signature": "restartUnmanaged($id)",
          "validation": "ValidationPatterns::isValidContainerName($id)",
          "authorization": "authorize('update', $this->server)",
          "logic": "$this->server->restartUnmanaged($id); dispatch('success'); loadUnmanagedContainers()",
          "error_handling": "try/catch → handleError($e, $this)"
        },
        "stopUnmanaged": {
          "signature": "stopUnmanaged($id)",
          "validation": "ValidationPatterns::isValidContainerName($id)",
          "authorization": "authorize('update', $this->server)",
          "logic": "$this->server->stopUnmanaged($id); dispatch('success'); loadUnmanagedContainers()",
          "error_handling": "try/catch → handleError($e, $this)"
        },
        "render": {
          "returns": "view('livewire.server.resources')"
        }
      },
      "auth_and_authorization": {
